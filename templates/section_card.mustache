{{!
    @template format_aicourse/section_card

    One section card on the course home page (2.5.0 card component).

    The card is a self-contained component: every class it uses starts with "acf-", so none of the
    earlier card rules in styles.css can reach it. Behaviour hooks are data attributes, not classes,
    so styling and behaviour can change independently.

    The title link is the one named, focusable way into the section. Its box is stretched over the
    whole card in CSS, so the card is one click target; the time, count, progress and call to
    action repeat what the link's accessible name already says and are aria-hidden.

    With an image, the image area shows it. Without one, the same area is a panel in the card's
    colour carrying the section label and title (see format_aicourse/card_media); the body then
    hides its own eyebrow and title visually, and the title stays for assistive technology.

    Data attributes required for JS:
    * data-for="section", data-id, data-number on the root; data-for="section_title" on the title -
      core_courseformat's reactive state manager binds to these.
    * data-section, data-sectionid, data-courseid - read by amd/src/courseformat.js.
    * data-drag-type="section" and data-action="moveSection" on the move handle - core's drag and
      drop and keyboard move dialogue.
    * data-acf-action="section-icon" | "duplicate-section" | "delete-section" - the edit buttons,
      bound by amd/src/courseformat.js.
    * data-acf-ring on .acf-progress - animated by amd/src/cards.js.
    * data-for="sectionBulkSelect" (core partial) - core's bulk editing.

    Context variables required for this template:
    * sectionid, sectionnum, courseid int.
    * sectionurl string Unescaped section URL.
    * sectionname string PRE-ESCAPED (format_string()) section name; triple mustache.
    * cardlinklabel string Accessible name of the title link.
    * uselistroles bool Emit role="listitem".
    * sectionbulk object|null Context for core_courseformat/local/content/section/bulkselect.
    * isediting, showeditbuttons bool.
    * editsectionurl, editsectionlabel, editsectiontitle, duplicatelabel, duplicatetitle, deletelabel,
      deletetitle, movelabel, movetitle, iconbuttonlabel, iconbuttontitle string (edit mode only).
    * media object Context for format_aicourse/card_media.
    * cardstyle string Inline style with the card's own colour, or empty.
    * cardstate string notstarted, progress or complete.
    * eyebrow string e.g. "Module 1".
    * hassummary bool / summary string Plain text.
    * hascount bool / counttext string e.g. "3 activities".
    * hastime bool / estimatedtime string e.g. "25 min".
    * hasprogress bool / percentnum int / donetext string e.g. "1 of 3".
    * statustext string e.g. "34% complete".
    * ctastate string start, continue, review or view. ctatext string.
    * hasactivities bool / activities array / moreactivities object|null - the optional activity
      list ("Show activities on cards"): url and name PRE-ESCAPED, label, state (completed,
      in_progress, not_started, none), cmid, modname, iconurl, hastime, timetext, istracked.

    Example context (json):
    {
        "sectionid": 35, "sectionnum": 1, "courseid": 2,
        "sectionurl": "https://example.org/course/section.php?id=35",
        "sectionname": "Foundations of Leadership",
        "cardlinklabel": "Foundations of Leadership, 3 activities, Estimated time 25 min",
        "uselistroles": true, "sectionbulk": null, "isediting": false, "showeditbuttons": false,
        "media": null, "cardstyle": "", "cardstate": "notstarted", "eyebrow": "Module 1",
        "hassummary": true, "summary": "What great leaders do differently.",
        "hascount": true, "counttext": "3 activities", "hastime": true, "estimatedtime": "25 min",
        "hasprogress": false, "percentnum": 0, "donetext": "", "statustext": "Not started",
        "ctastate": "start", "ctatext": "Start",
        "hasactivities": false, "activities": [], "moreactivities": null
    }
}}
<div class="acf-card acf-card--section acf-card--{{cardstate}}{{^media.hasimage}} acf-card--noimage{{/media.hasimage}}"{{#cardstyle}} style="{{cardstyle}}"{{/cardstyle}}{{#uselistroles}} role="listitem"{{/uselistroles}} data-for="section" data-id="{{sectionid}}" data-number="{{sectionnum}}" data-section="{{sectionnum}}" data-sectionid="{{sectionid}}" data-courseid="{{courseid}}">
{{#sectionbulk}}
<div class="acf-card__bulk">
{{> core_courseformat/local/content/section/bulkselect }}
</div>
{{/sectionbulk}}
{{#showeditbuttons}}
<div class="acf-card__admin">{{!
}}<button type="button" class="acf-card__adminbtn" data-action="moveSection" data-id="{{sectionid}}" data-drag-type="section" aria-label="{{movelabel}}" title="{{movetitle}}"><svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="6" r="1"/><circle cx="9" cy="12" r="1"/><circle cx="9" cy="18" r="1"/><circle cx="15" cy="6" r="1"/><circle cx="15" cy="12" r="1"/><circle cx="15" cy="18" r="1"/></svg></button>{{!
}}<button type="button" class="acf-card__adminbtn" data-acf-action="section-icon" data-courseid="{{courseid}}" data-sectionid="{{sectionid}}" aria-label="{{iconbuttonlabel}}" title="{{iconbuttontitle}}"><svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><path d="M9 9h.01"/><path d="M15 9h.01"/></svg></button>{{!
}}<a href="{{editsectionurl}}" class="acf-card__adminbtn" aria-label="{{editsectionlabel}}" title="{{editsectiontitle}}"><svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg></a>{{!
}}<button type="button" class="acf-card__adminbtn" data-acf-action="duplicate-section" data-sectionid="{{sectionid}}" data-courseid="{{courseid}}" aria-label="{{duplicatelabel}}" title="{{duplicatetitle}}"><svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg></button>{{!
}}<button type="button" class="acf-card__adminbtn acf-card__adminbtn--danger" data-acf-action="delete-section" data-sectionid="{{sectionid}}" data-courseid="{{courseid}}" data-sectionnum="{{sectionnum}}" aria-label="{{deletelabel}}" title="{{deletetitle}}"><svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button>{{!
}}</div>
{{/showeditbuttons}}
{{#media}}
{{> format_aicourse/card_media }}
{{/media}}
<div class="acf-card__body">
<span class="acf-card__eyebrow" aria-hidden="true">{{eyebrow}}</span>
<a href="{{sectionurl}}" class="acf-card__link" aria-label="{{cardlinklabel}}"><h3 class="acf-card__title" data-for="section_title" data-id="{{sectionid}}" data-number="{{sectionnum}}">{{{sectionname}}}</h3></a>
{{#hassummary}}
<p class="acf-card__summary">{{summary}}</p>
{{/hassummary}}
{{#hascount}}
<div class="acf-card__meta" aria-hidden="true">{{!
}}<span class="acf-card__metaitem"><svg focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/></svg>{{counttext}}</span>{{!
}}{{#hastime}}<span class="acf-card__metaitem acf-card__time"><svg focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>{{estimatedtime}}</span>{{/hastime}}{{!
}}</div>
{{/hascount}}
{{#hasactivities}}
<ul class="acf-list">
{{#activities}}
<li class="acf-list__item" data-cmid="{{cmid}}" data-modname="{{modname}}"><a href="{{{url}}}" class="acf-list__link" aria-label="{{label}}">{{!
}}<img class="acf-list__icon" src="{{iconurl}}" alt="" aria-hidden="true" loading="lazy">{{!
}}<span class="acf-list__name">{{{name}}}</span>{{!
}}{{#hastime}}<span class="acf-list__time" aria-hidden="true">{{timetext}}</span>{{/hastime}}{{!
}}{{#istracked}}<span class="acf-list__state acf-list__state--{{state}}" aria-hidden="true"></span>{{/istracked}}{{!
}}</a></li>
{{/activities}}
{{#moreactivities}}
<li class="acf-list__item"><a href="{{url}}" class="acf-list__more" aria-label="{{label}}" title="{{label}}">+{{remaining}}</a></li>
{{/moreactivities}}
</ul>
{{/hasactivities}}
<div class="acf-card__foot" aria-hidden="true">
{{#hasprogress}}
<div class="acf-progress" data-acf-ring="{{percentnum}}"><span class="acf-progress__track"><span class="acf-progress__fill" style="width:{{percentnum}}%"></span></span><span class="acf-progress__count">{{donetext}}</span></div>
{{/hasprogress}}
<div class="acf-card__cta"><span class="acf-card__status">{{statustext}}</span><span class="acf-card__action acf-card__action--{{ctastate}}">{{ctatext}}<svg focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></span></div>
</div>
</div>
</div>
