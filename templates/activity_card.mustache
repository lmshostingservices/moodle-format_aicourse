{{!
    @template format_aicourse/activity_card

    One activity card on a section page (2.5.0 card component). The whole card is one link.

    Completion is never shown by colour alone: the link's accessible name says it in words, and the
    status chip on the image says it visibly when there is something to say (In progress,
    Completed). "Not started" is not printed on every card.

    Data attributes required for JS:
    * data-for="cmitem" and data-id - core_courseformat's reactive state manager.
    * data-cmid, data-status - amd/src/courseformat.js.

    Context variables required for this template:
    * issubsection bool Links to a delegated mod_subsection section.
    * cmid int. url string Unescaped. status string completed, in_progress or not_started.
    * haslabel bool / cardlabel string Accessible name.
    * name string PRE-ESCAPED (format_string()); triple mustache.
    * typename string Localised module type. iconurl string Module icon.
    * hastime bool / estimatedtime string / timelabel string.
    * media object Context for format_aicourse/card_media. cardstyle string.

    Example context (json):
    {
        "issubsection": false, "cmid": 12, "url": "https://example.org/mod/page/view.php?id=12",
        "status": "completed", "haslabel": true, "cardlabel": "Recognition that works (Completed)",
        "name": "Recognition that works", "typename": "Page",
        "iconurl": "https://example.org/theme/image.php/boost/page/1/monologo",
        "hastime": true, "estimatedtime": "10 min", "timelabel": "Estimated time: 10 min",
        "media": null, "cardstyle": ""
    }
}}
<a href="{{url}}" class="acf-card acf-card--activity{{^media.hasimage}} acf-card--noimage{{/media.hasimage}}"{{#cardstyle}} style="{{cardstyle}}"{{/cardstyle}} data-status="{{status}}" data-cmid="{{cmid}}"{{#haslabel}} aria-label="{{cardlabel}}"{{/haslabel}} data-for="cmitem" data-id="{{cmid}}">
{{#media}}
{{> format_aicourse/card_media }}
{{/media}}
<div class="acf-card__body">
<h3 class="acf-card__title">{{{name}}}</h3>
<span class="acf-card__meta">{{!
}}<span class="acf-card__metaitem">{{#issubsection}}<svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/><path d="M14 4h7"/><path d="M14 9h7"/><path d="M14 15h7"/><path d="M14 20h7"/></svg>{{/issubsection}}{{^issubsection}}<img class="acf-card__typeicon" src="{{iconurl}}" alt="" aria-hidden="true">{{/issubsection}}{{typename}}</span>{{!
}}{{#hastime}}<span class="acf-card__metaitem acf-card__time" title="{{timelabel}}"><svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span class="accesshide">{{timelabel}}</span><span aria-hidden="true">{{estimatedtime}}</span></span>{{/hastime}}{{!
}}</span>
</div>
</a>
