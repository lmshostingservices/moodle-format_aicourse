<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="course/format/aicourse/db" VERSION="20260815" COMMENT="XMLDB file for AI Course Format chat history and memory">
  <TABLES>
    <TABLE NAME="format_aicourse_chats" COMMENT="AI Course Assistant chat history">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Course ID"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="User who asked the question"/>
        <FIELD NAME="activityid" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="Activity ID if on activity page"/>
        <FIELD NAME="questionslot" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Quiz question slot number if on quiz"/>
        <FIELD NAME="question" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Question asked"/>
        <FIELD NAME="response" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="AI response"/>
        <FIELD NAME="rating" TYPE="int" LENGTH="2" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="User rating: 0=unrated, 1=helpful, -1=not helpful"/>
        <FIELD NAME="refused" TYPE="int" LENGTH="1" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="1 if AI refused to provide answer (academic integrity)"/>
        <FIELD NAME="locked" TYPE="int" LENGTH="1" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="1 if activity was locked (submitted)"/>
        <FIELD NAME="correction" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Correct answer provided by teacher"/>
        <FIELD NAME="correctedby" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="User who provided correction"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Timestamp when question was asked"/>
        <FIELD NAME="timecorrected" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Timestamp when correction was made"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="correctedby" TYPE="foreign" FIELDS="correctedby" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseid_userid_idx" UNIQUE="false" FIELDS="courseid, userid" COMMENT="Course report student filter, and privacy export/delete by user within a course"/>
        <INDEX NAME="courseid_timecreated_idx" UNIQUE="false" FIELDS="courseid, timecreated" COMMENT="Course report listing, which is always courseid = ? ORDER BY timecreated DESC"/>
        <INDEX NAME="timecreated_idx" UNIQUE="false" FIELDS="timecreated"/>
        <INDEX NAME="rating_idx" UNIQUE="false" FIELDS="rating"/>
        <INDEX NAME="activityid_idx" UNIQUE="false" FIELDS="activityid"/>
        <INDEX NAME="refused_idx" UNIQUE="false" FIELDS="refused"/>
        <INDEX NAME="questionslot_idx" UNIQUE="false" FIELDS="questionslot"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="format_aicourse_ai_memory" COMMENT="Per-activity AI memory for scaffolded tutoring">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Course ID"/>
        <FIELD NAME="activityid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Activity ID"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="User ID"/>
        <FIELD NAME="memory" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Summary of prior tutoring (topics, not answers)"/>
        <FIELD NAME="timeupdated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Last update timestamp"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="unique_memory" UNIQUE="true" FIELDS="courseid, activityid, userid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
